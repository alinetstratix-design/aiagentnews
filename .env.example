# WordPress Configuration
WP_URL=https://news.codevoraai.com
WP_USERNAME=your_wordpress_username_or_email
WP_APP_PASSWORD=your_24_char_application_password

# 100% Free Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_free_gemini_api_key_here

# Post Status: 'publish' (live immediately) or 'draft' (save as draft for manual review)
POST_STATUS=publish

# Max articles to process each time the script runs (recommended: 2 to 5)
MAX_ARTICLES_PER_RUN=3
